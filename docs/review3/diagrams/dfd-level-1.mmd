flowchart LR
  U(["User"])
  AI(["AI provider (optional)"])
  D1[("D1 users")]
  D2[("D2 categories")]
  D3[("D3 transactions")]
  D4[("D4 budgets")]

  P1(("1.0<br/>Authenticate"))
  P2(("2.0<br/>Manage<br/>categories"))
  P3(("3.0<br/>Manage<br/>transactions"))
  P4(("4.0<br/>Manage<br/>budgets"))
  P5(("5.0<br/>Dashboard &<br/>analytics"))
  P6(("6.0<br/>Generate<br/>insights"))

  U -- "name, email, password" --> P1
  P1 -- "JWT, user profile" --> U
  P1 <-- "user rows (bcrypt hash)" --> D1
  P1 -- "9 default categories on sign-up" --> D2

  U -- "category name/type" --> P2
  P2 -- "category list / errors" --> U
  P2 <--> D2

  U -- "transaction fields,<br/>filters" --> P3
  P3 -- "transactions" --> U
  P3 <--> D3
  P3 -- "category ownership & type check" --> D2

  U -- "limit, period" --> P4
  P4 -- "budgets + status" --> U
  P4 <--> D4
  P4 -- "SUM of expenses in period" --> D3

  U -- "report request" --> P5
  P5 -- "totals, chart data" --> U
  P5 -- "aggregate queries" --> D3
  P5 -- "active budgets" --> D4

  U -- "insights request" --> P6
  P6 -- "insight list + source" --> U
  P6 -- "month totals, category spend, budgets" --> D3
  P6 -- "budget status" --> D4
  P6 -. "aggregated data" .-> AI
  AI -. "insight sentences" .-> P6
